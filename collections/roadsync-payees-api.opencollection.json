{
  "opencollection": "1.0.0",
  "info": {
    "name": "Client API v1.8 authenticated payees API",
    "version": "1.8.45"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "payees",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get a List of All Payees",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://client-api.staging.roadsync.com/{basePath}/payees",
            "headers": [
              {
                "name": "broker-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "dot",
                "value": "",
                "type": "query",
                "description": "Filter payees by DOT number"
              }
            ]
          },
          "docs": "Return a list of all Payees associated with a Broker."
        },
        {
          "info": {
            "name": "Create a Payee",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://client-api.staging.roadsync.com/{basePath}/payees",
            "headers": [
              {
                "name": "broker-id",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a Payee."
        },
        {
          "info": {
            "name": "Get a Single Payee",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://client-api.staging.roadsync.com/{basePath}/payees/:payee_id",
            "headers": [
              {
                "name": "broker-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "payee_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve the information of one specific Payee."
        },
        {
          "info": {
            "name": "Update a Single Payee",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://client-api.staging.roadsync.com/{basePath}/payees/:payee_id",
            "headers": [
              {
                "name": "broker-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "payee_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Edit the information of the specified Payee. Only Payees that are not verified can be updated."
        }
      ]
    }
  ],
  "bundled": true
}