{
  "opencollection": "1.0.0",
  "info": {
    "name": "Client API v1.8 authenticated ping API",
    "version": "1.8.45"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "ping",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Ping the payment-api service. Will also validate the api key present on the request",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://client-api.staging.roadsync.com/{basePath}/ping"
          },
          "docs": "Ping the payment-api service"
        }
      ]
    }
  ],
  "bundled": true
}